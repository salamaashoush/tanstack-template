{
  "name": "tanstack-template",
  "version": "0.0.0",
  "description": "TanStack Template",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run vite dev",
    "build": "bun --env-file=.env run vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "bun --env-file=.env run vite preview",
    "lint": "oxlint --type-aware && bun scripts/check-i18n.ts",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "type-check": "tsc --noEmit",
    "test": "bun --env-file=.env run vitest",
    "coverage": "bun --env-file=.env run vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps",
    "postinstall": "bun scripts/compile-i18n.ts",
    "prepare": "bun .husky/install.mjs && bun scripts/setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0",
    "valibot-env": "^1.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-query": "^0.1.1",
    "oxlint-plugin-router": "^0.1.1",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "vitest-dom": "^0.1.1"
  },
  "lint-staged": {
    "*": "oxfmt",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "msw"
  ]
}
